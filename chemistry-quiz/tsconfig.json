{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true,
    "types": ["node", "jest"],
    "removeComments": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*.ts", "public/js/api.js", "public/js/dom.js"]
}
