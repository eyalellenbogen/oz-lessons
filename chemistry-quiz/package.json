{
  "name": "chemistry-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "Short lessons followed by a quiz: matter, atoms, the periodic table, physical/chemical changes and chemical equations",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "vite",
    "dev": "vite",
    "preview": "vite preview",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.[jt]s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "lucide": "^1.60.0"
  }
}
